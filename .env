# Environment Configuration for ADK Server
# Shared between fastapi-server and adk-web

# LLM Provider: google, groq, openrouter
LLM_PROVIDER=google

# API Keys - Replace with your actual keys in the placeholders
GOOGLE_API_KEY={GOOGLE_API_KEY}
GROQ_API_KEY={GROQ_API_KEY}
OPENROUTER_API_KEY={OPENROUTER_API_KEY}

# Strip thinking/reasoning from model responses (true/false)
# Se true, rimuove automaticamente il thinking (DeepSeek R1, Qwen 3, Claude, ecc.)
STRIP_THINKING=true

# Python
PYTHONUNBUFFERED=1


