# Environment Configuration for ADK Server
# Shared between fastapi-server and adk-web

# LLM Provider: google, groq, openrouter
LLM_PROVIDER=google

# API Keys - Replace with your actual keys in the placeholders
GOOGLE_API_KEY={GOOGLE_API_KEY}
GROQ_API_KEY={GROQ_API_KEY}
OPENROUTER_API_KEY={OPENROUTER_API_KEY}

# Strip thinking/reasoning mode: force / adaptive / none
# force    = applica sempre lo strip (anche Gemini)
# adaptive = applica solo se il modello lo supporta (default)
# none     = non applica mai lo strip
STRIP_THINKING=adaptive

# Python
PYTHONUNBUFFERED=1